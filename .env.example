# Bullet environment template.
# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
# This file carries NO real values — placeholders only.

# ─── Stellar / Soroban ───────────────────────────────────────────────
STELLAR_NETWORK=testnet
# NOT named SOROBAN_RPC_URL. The stellar CLI auto-loads .env from the working
# directory, and a SOROBAN_RPC_URL key there is taken as an --rpc-url it has no
# matching passphrase for, so its built-in `testnet` alias fails with
# "rpc-url is used but network passphrase is missing" for every command run
# inside the repo. Adding NETWORK_PASSPHRASE here does not satisfy it. The code
# still reads SOROBAN_RPC_URL as a fallback, but do not put that key in .env.
BULLET_RPC_URL=https://soroban-testnet.stellar.org
ZEEKPAY_CONTRACT_ID=
USDC_SAC_ID=
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ─── Deployer (NEVER commit a real value) ────────────────────────────
DEPLOYER_SECRET_KEY=

# ─── Admin / relayer (NEVER commit a real value) ─────────────────────
# Must be the address set as admin during contract initialize().
# Backend (deposit indexer) uses this to call post_root after confirming
# on-chain deposit events.
ZEEKPAY_ADMIN_KEY=

# ─── Invite custody (NEVER commit real values) ───────────────────────
# Master funder that seeds per-invite custody accounts.
BULLET_CUSTODY_MASTER_SECRET=
# 32-byte hex (64 chars) key used to encrypt custody Stellar secrets at rest
# in pending_invites. REQUIRED for the invite flow; without it the backend
# refuses to store custody secrets (fail closed). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BULLET_CUSTODY_ENC_KEY=

# ─── Supabase (backend) ──────────────────────────────────────────────
# SUPABASE_URL and SUPABASE_ANON_KEY are safe to expose.
# SUPABASE_SERVICE_ROLE_KEY is a SECRET; backend-only. Grab it from
# Supabase dashboard → Project Settings → API → service_role.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Backend resolver ────────────────────────────────────────────────
RESOLVER_PORT=3001
FRONTEND_URL=http://localhost:3000

# ─── Deposit indexer ─────────────────────────────────────────────────
# First ledger to scan when Postgres has no cursor yet (fresh deploy). Set to
# ~the contract creation ledger so the first run backfills all historic
# deposits (bounded by RPC event retention). 0 = fall back to a ~1-day lookback.
INDEXER_START_LEDGER=0
# Shared secret guarding POST /admin/reindex (manual backfill/recovery). Send as
# the x-admin-token header. Leave empty to disable the endpoint.
INDEXER_ADMIN_TOKEN=

# ─── Telegram handle linking ─────────────────────────────────────────
# Telegram is not a Supabase OAuth provider, so the backend proves ownership
# itself: POST /telegram/link verifies the Login Widget's HMAC with this token
# (backend/src/telegram.ts). SECRET, backend-only: anyone holding it can forge
# a login for any Telegram account. Get it from @BotFather (/newbot), then
# point the bot at the site with /setdomain. Unset = the route returns 503.
TELEGRAM_BOT_TOKEN=
# The bot's numeric id: the part of TELEGRAM_BOT_TOKEN before the colon. Not a
# secret, and the login popup takes this rather than the @username
# (frontend/src/components/TelegramLogin.tsx). Unset = the Telegram button is
# not rendered at all.
NEXT_PUBLIC_TELEGRAM_BOT_ID=

# ─── Frontend (NEXT_PUBLIC_* are exposed to the browser) ─────────────
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_CONTRACT_ID=
NEXT_PUBLIC_RESOLVER_URL=http://localhost:3001
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Wallet connections from the Freighter mobile app's in-app browser go over the
# WalletConnect v2 relay, which needs a project id (free, no card) from
# https://dashboard.reown.com. Leave empty and the desktop extension still
# works; mobile shows "not configured on this deployment" instead of hanging.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── Admin dashboard (dashboard.sendbullet.xyz) ──────────────────────
# Comma-separated emails allowed to view /dashboard. Empty = nobody.
ADMIN_EMAILS=
# The dashboard aggregates across all users, so it needs the service role
# key server-side. Same value as SUPABASE_SERVICE_ROLE_KEY above; set it on
# the frontend deployment too. NEVER prefix it with NEXT_PUBLIC_.
